%% RIBAT — Hedera Integration Map
flowchart LR
  classDef private fill:#fff8ee,color:#5c3b1f,stroke:#e58a3a,stroke-width:1.5px
  classDef ribat fill:#e7f4f1,color:#155f5a,stroke:#187c76,stroke-width:1.5px
  classDef hedera fill:#eef0fb,color:#493d79,stroke:#7665a8,stroke-width:2px
  classDef public fill:#eaf0f5,color:#405d76,stroke:#4e7293,stroke-width:1.5px
  classDef no fill:#f5f5f1,color:#73746d,stroke:#96978d,stroke-dasharray: 5 4
  classDef note fill:#f7f5ef,color:#65665f,stroke:#c9c6bc,stroke-dasharray: 2 3

  subgraph PRIVATE[Private commercial world — never published]
    DOC[Invoice / traite<br/>PDF/XML · names · amount · tax IDs]:::private
    LENDER[Lender private system]:::private
    KEYS[INV1 / INV2 / INV3<br/>canonical candidates]:::private
    STORE[(Private registry<br/>commitments · documents · member data)]:::private
  end

  subgraph RIBAT[RIBAT controlled layer]
    GATE[Gateway<br/>member auth · rate limit · policy]:::ribat
    BLIND[Blind / commit<br/>privacy boundary]:::ribat
    MATCH[Collision evaluator]:::ribat
    ATOMIC[Atomic registry transition<br/>rank 1 / blocked / state change]:::ribat
    ENVELOPE[Minimal event envelope<br/>event · nullifier · partyId · rank · status · docCommitment]:::ribat
    INDEX[RIBAT indexer / state projection]:::ribat
    VERIFY[Verify API + public page]:::public
  end

  subgraph HEDERA[Hedera network — neutral ordering and audit]
    TOPIC[HCS Topic<br/>controlled submit key]:::hedera
    MSG[Topic message<br/>≤ 1 KiB compact payload]:::hedera
    TS[Consensus timestamp<br/>network-agreed order]:::hedera
    SEQ[Sequence number<br/>topic position]:::hedera
    ROOT[Epoch / Merkle root<br/>periodic checkpoint]:::hedera
    HBAR[HBAR<br/>operator-paid network fee]:::hedera
  end

  subgraph READ[Read and verification world]
    MIRROR[Mirror Node<br/>query · filter · replay]:::public
    AUDITOR[Auditor / regulator / insurer]:::public
    CARD[Link Card / Verify proof<br/>redacted evidence]:::public
  end

  DOC --> LENDER --> KEYS --> GATE
  KEYS --> STORE
  GATE --> BLIND --> MATCH
  MATCH --> STORE
  MATCH -->|CLEAR| ATOMIC
  MATCH -->|COLLISION| GATE
  ATOMIC --> STORE
  ATOMIC --> ENVELOPE
  ENVELOPE --> MSG --> TOPIC
  TOPIC --> TS
  TOPIC --> SEQ
  TS & SEQ --> MIRROR
  TOPIC --> ROOT
  MIRROR --> INDEX --> VERIFY --> CARD
  MIRROR --> AUDITOR
  ENVELOPE -. no raw document .-> MSG
  DOC -. forbidden payload .-> TOPIC
  HBAR -. pays fee, not a user asset .-> MSG
  ROOT --> VERIFY

  LIMIT[Hedera meaning for RIBAT:<br/>neutral ordering + timestamp + replayable public evidence<br/>not private matching, legal validity, storage or payment]:::note
  LIMIT -.-> TS
  LIMIT -.-> VERIFY

  style PRIVATE fill:#fffaf3,stroke:#e58a3a
  style RIBAT fill:#eff8f5,stroke:#187c76
  style HEDERA fill:#f3f0fb,stroke:#7665a8
  style READ fill:#eef3f7,stroke:#4e7293
